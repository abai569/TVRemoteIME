<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 遥控器选中（聚焦）时：亮黄色填充 -->
    <item android:state_focused="true" android:state_pressed="false" android:color="#FFD54F" />
    <item android:state_pressed="true" android:color="#BDBDBD" />
    <!-- 默认透明（outline 样式） -->
    <item android:color="@android:color/transparent" />
</selector>
